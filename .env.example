# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Model Configuration
MODEL_UNITS=128
MODEL_LAYERS=2
MODEL_DROPOUT=0.2
MODEL_LEARNING_RATE=0.001

# Training Configuration
TRAINING_EPOCHS=100
TRAINING_BATCH_SIZE=32
TRAINING_PATIENCE=10

# Paths
MODELS_DIR=models
DATA_DIR=data
EXPLANATIONS_DIR=explanations

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: Docker Hub credentials for deployment
# DOCKER_USERNAME=your_username
# DOCKER_PASSWORD=your_password
